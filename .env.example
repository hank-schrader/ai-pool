# ai-pool server settings. Copy to .env to change them; every value below is
# also the built-in default, so the server runs without any .env file.
# Models are configured in the JSON catalog (POOL_CATALOG), not here.

# Address to listen on. Local mode (below) only allows loopback addresses.
POOL_BIND=127.0.0.1:8080
# Model catalog: API names, descriptions, weight downloads, context profiles.
POOL_CATALOG=config/models.json

# Clients need only the pool URL in every mode; Authorization is ignored.
# local: miner/admin routes are open, loopback only (single-machine development).
# keys:  miners need POOL_MINER_TOKENS unless POOL_MINER_AUTH=open; admin status
#        needs POOL_ADMIN_TOKEN. Required to serve other machines. Use TLS (a
#        reverse proxy with HTTPS/WSS) when the pool is reachable from outside.
POOL_AUTH_MODE=local
# Comma-separated secrets, used only when POOL_AUTH_MODE=keys.
POOL_MINER_TOKENS=
# token: miners need one of POOL_MINER_TOKENS.
# open:  anyone may connect a miner without a token (miners see the requests
#        they serve and could return wrong answers).
POOL_MINER_AUTH=token
# Concurrent miner connections accepted.
POOL_MAX_MINERS=256
# Concurrent public statistics SSE connections (positive integer).
POOL_MAX_STATS_STREAMS=128
# Bearer token for GET /admin/v1/status in keys mode (open in local mode).
POOL_ADMIN_TOKEN=

# Deadlines, in seconds. A retry never extends the request deadline.
POOL_REQUEST_TIMEOUT_SECONDS=180
POOL_COUNT_TIMEOUT_SECONDS=10
POOL_QUEUE_TIMEOUT_SECONDS=15
POOL_DISPATCH_ACK_TIMEOUT_SECONDS=5
POOL_FIRST_CHUNK_TIMEOUT_SECONDS=60

# Admission limits. Waiting work queues at the pool, never on miners.
# Queue capacities: unset = automatic, computed at admission time from the connected,
# non-draining miners: 4 x their slots (at least 16), globally and per model (only
# miners serving that model). Set a number to use a fixed operator cap instead.
# Dispatch is FIFO (oldest queued job first).
#POOL_QUEUE_CAPACITY_GLOBAL=
#POOL_QUEUE_CAPACITY_PER_MODEL=
# All inference requests share the client label "public" for fairness and logs.
# Per-client limits therefore apply to all callers together: unset = no limit.
# Set a number to cap their combined running / waiting requests.
#POOL_MAX_ACTIVE_PER_CLIENT=
#POOL_MAX_QUEUED_PER_CLIENT=
# When both are set, all requests count from the moment their headers arrive
# (before the body is read or token-counted). At capacity, admission immediately
# returns HTTP 429 rate_limit_exceeded with Retry-After. Authorization headers
# do not give callers separate limits.

# Miners send heartbeats this often; three missed ones disconnect a miner.
POOL_HEARTBEAT_SECONDS=10
# Stream events buffered per client; a client that falls further behind is cancelled.
POOL_STREAM_BUFFER_EVENTS=512

RUST_LOG=info
