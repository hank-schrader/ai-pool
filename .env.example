# ai-pool server settings. Copy to .env to change them; every value below is
# also the built-in default, so the server runs without any .env file.
# Models are configured in the JSON catalog (POOL_CATALOG), not here.

# Address to listen on. Local mode (below) only allows loopback addresses.
POOL_BIND=127.0.0.1:8080
# Model catalog: API names, descriptions, weight downloads, context profiles.
POOL_CATALOG=config/models.json

# local: no credentials, loopback only (single-machine development).
# keys:  clients need a key from POOL_CLIENT_API_KEYS, miners a token from
#        POOL_MINER_TOKENS. Required to serve other machines. Use TLS (a
#        reverse proxy with HTTPS/WSS) when the pool is reachable from outside.
POOL_AUTH_MODE=local
# Comma-separated secrets, used only when POOL_AUTH_MODE=keys.
POOL_CLIENT_API_KEYS=
POOL_MINER_TOKENS=
# Bearer token for GET /admin/v1/status in keys mode (open in local mode).
POOL_ADMIN_TOKEN=

# Deadlines, in seconds. A retry never extends the request deadline.
POOL_REQUEST_TIMEOUT_SECONDS=180
POOL_COUNT_TIMEOUT_SECONDS=10
POOL_QUEUE_TIMEOUT_SECONDS=15
POOL_DISPATCH_ACK_TIMEOUT_SECONDS=5
POOL_FIRST_CHUNK_TIMEOUT_SECONDS=60

# Admission limits. Waiting work queues at the pool, never on miners.
POOL_QUEUE_CAPACITY_GLOBAL=64
POOL_QUEUE_CAPACITY_PER_MODEL=32
POOL_MAX_ACTIVE_PER_CLIENT=2
POOL_MAX_QUEUED_PER_CLIENT=8

# Miners send heartbeats this often; three missed ones disconnect a miner.
POOL_HEARTBEAT_SECONDS=10
# Stream events buffered per client; a client that falls further behind is cancelled.
POOL_STREAM_BUFFER_EVENTS=512

RUST_LOG=info
