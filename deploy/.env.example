# Public host name routed by Traefik (DNS record pointing at this server).
POOL_HOST=pool.example.com
# Docker network of the running Traefik container (docker network ls).
TRAEFIK_NETWORK=traefik_default
# Traefik certificate resolver name from its traefik.yml.
TRAEFIK_CERT_RESOLVER=myresolver

# Secrets, comma-separated. Generate each with: openssl rand -hex 32
POOL_CLIENT_API_KEYS=
POOL_MINER_TOKENS=
POOL_ADMIN_TOKEN=
# open: miners connect without a token (anonymous); token: they need one of POOL_MINER_TOKENS.
POOL_MINER_AUTH=token

# Container memory limit (default 1g); keeps a spike from taking down the other services on the host.
#POOL_MEMORY_LIMIT=1g

# Any other POOL_* setting from ../.env.example can be set here too.
RUST_LOG=info
