{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true, "noEmit": true,
    "allowJs": true, "checkJs": true, "isolatedModules": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts", "svelte.config.js"]
}
